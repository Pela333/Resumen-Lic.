# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NUNCA se comparte ni se sube a internet.

# Cuenta de Gmail dedicada que ENVÍA el resumen.
# La clave NO es la contraseña normal: es una "contraseña de aplicación" de 16 letras
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
GMAIL_USUARIO=
GMAIL_CLAVE_APLICACION=

# Quién RECIBE el resumen. Varios separados por coma.
MAIL_DESTINATARIOS=
